{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "apps/laravel-with-nestjs/src",
  "compilerOptions": {
    "deleteOutDir": true,
    "builder": "rspack",
    "tsConfigPath": "apps/laravel-with-nestjs/tsconfig.app.json"
  },
  "monorepo": true,
  "root": "apps/laravel-with-nestjs",
  "projects": {
    "admin-panel": {
      "type": "application",
      "root": "apps/admin-panel",
      "entryFile": "main",
      "sourceRoot": "apps/admin-panel/src",
      "compilerOptions": {
        "tsConfigPath": "apps/admin-panel/tsconfig.app.json"
      }
    },
    "laravel-with-nestjs": {
      "type": "application",
      "root": "apps/laravel-with-nestjs",
      "entryFile": "main",
      "sourceRoot": "apps/laravel-with-nestjs/src",
      "compilerOptions": {
        "tsConfigPath": "apps/laravel-with-nestjs/tsconfig.app.json"
      }
    },
    "prisma": {
      "type": "library",
      "root": "libs/prisma",
      "entryFile": "index",
      "sourceRoot": "libs/prisma/src",
      "compilerOptions": {
        "tsConfigPath": "libs/prisma/tsconfig.lib.json"
      }
    }
  }
}